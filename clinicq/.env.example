# Copy to .env (or export in your shell). All values are optional for local dev.
PORT=3000
HOST=0.0.0.0
# Where the SQLite file lives
DB_PATH=./data/clinicq.db
# REQUIRED when NODE_ENV=production. Use a long random string.
JWT_SECRET=change-me
# Time zone used for "today", slot times and queue dates
APP_TZ=Asia/Kolkata
